# ===== LLM 主脑（Gemini / 任意 OpenAI 兼容端点）=====
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-endpoint/v1
LLM_MODEL=gemini-2.0-flash-exp

# 视觉：开启后，输入含“看看/屏幕/截图”等关键词会自动截图传给模型
ENABLE_VISION=false

# ===== 语音服务（SiliconFlow：STT）=====
SILICON_API_KEY=your-silicon-key
SILICON_BASE_URL=https://api.siliconflow.cn/v1
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# ===== 本地嵌入模型（可选，缺省则长期记忆检索降级）=====
# EMBEDDING_MODEL_PATH=./models/sentence-embedding

# ===== 本地 TTS 微服务（GPT-SoVITS）=====
TTS_SERVICE_URL=http://127.0.0.1:9880
TTS_TIMEOUT=60

# ===== 角色卡 =====
# PERSONA_PATH=./personas/pet.txt
PET_NAME=小七

# ===== 主动发言（无聊检测，秒）=====
BOREDOM_THRESHOLD=1500
BOREDOM_MAX=3600

# ===== 闹钟 =====
ALARM_ENABLED=true
ALARM_CHECK_INTERVAL=10
ALARM_DEFAULT_MESSAGE=⏰ 闹钟时间到了！

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
