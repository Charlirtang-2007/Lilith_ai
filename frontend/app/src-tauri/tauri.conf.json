{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lilith-pet",
  "version": "0.2.0",
  "identifier": "cn.lilith.desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌面宠物",
        "width": 350,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "resizable": false,
        "center": true,
        "shadow": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$DOWNLOAD/**",
            "$DESKTOP/**",
            "$DOCUMENT/**",
            "$PICTURE/**",
            "$TEMP/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage",
      "deb",
      "rpm",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI 桌面宠物：Live2D 角色 + 大模型对话 + 本地语音"
  }
}
