{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lilith-pet",
  "version": "0.3.0",
  "identifier": "cn.lilith.desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lilith · 桌面伴侣",
        "width": 300,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "resizable": false,
        "center": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required",
        "minWidth": 300,
        "maxWidth": 300,
        "minHeight": 520,
        "maxHeight": 520,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob: http://127.0.0.1:8001; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8001 ws://127.0.0.1:8001; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage",
      "deb",
      "rpm",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI 桌面宠物：Live2D 角色 + 大模型对话 + 本地语音"
  }
}